{
  // ACP agent command — any ACP-compatible agent
  "agentCmd": "devin acp",

  // Working directory for the agent subprocess (default: cwd)
  "agentCwd": ".",

  // Platforms — at least one is required
  "platforms": {
    "telegram": {
      "token": "YOUR_BOT_TOKEN",
      "allowedChatIds": [123456789]
    }
    // Discord (optional, v0.2.0+)
    // "discord": {
    //   "token": "YOUR_DISCORD_BOT_TOKEN",
    //   "allowedChannelIds": [123456789]
    // }
  },

  // ACP session (optional — omit to create a new session each run)
  // "sessionId": "some-session-id",

  // Initial session mode (optional — applied after session/new, session/load, or session/resume)
  // Agent-specific. Devin supports: "accept-edits", "smart", "ask", "plan", "bypass"
  // "bypass" auto-approves all tool calls — no permission requests sent to the client.
  // "sessionMode": "bypass",

  // MCP/session config path (optional)
  // The file is passed to the agent unchanged. Supports stdio, HTTP, SSE, and ACP transports.
  // Example acp_session.jsonc:
  // {
  //   "mcpServers": [
  //     { "type": "stdio", "name": "fs", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"], "env": [] },
  //     { "type": "http", "name": "api", "url": "https://api.example.com/mcp", "headers": [{ "name": "Authorization", "value": "Bearer xxx" }] }
  //   ]
  // }
  // "sessionConfigPath": "acp_session.jsonc",

  // Show agent thoughts in chat (default: false)
  "showThoughts": false,

  // Show tool calls (e.g. "Read file", "Run tests") in chat (default: true)
  // Set to false when the agent is not used for programming and only the final answer matters
  "showTools": true,

  // Show agent plan/checklist in chat (default: true)
  // Set to false to hide plan entries and reduce noise
  "showPlan": true,

  // Stream responses with message edits (default: true)
  "streaming": true,

  // Log level: "error" | "info" | "debug" (default: "info")
  "logLevel": "info",

  // Scheduled jobs — can also be managed via /cron commands in Telegram
  "cron": [
    {
      "name": "daily-briefing",
      "schedule": "0 9 * * *",
      "prompt": "summarize today's calendar and unread emails",
      "chatId": 123456789
    }
  ],

  // Named reusable prompts — can also be managed via /routine commands
  "routines": [
    { "name": "briefing", "prompt": "summarize today's calendar and unread emails" },
    { "name": "review", "prompt": "review the latest PRs on my repos" }
  ],

  // HTTP server (optional, default off)
  // "http": {
  //   "enabled": true,
  //   "host": "127.0.0.1",       // bind address (default localhost)
  //   "port": 7780,
  //   "auth": {
  //     "token": "your-secret"    // bearer token (optional)
  //   },
  //   "forwardHeaders": false,    // forward request headers to agent (Authorization always stripped)
  //   "maxBodySize": 1048576,     // 1MB
  //   "rateLimit": 60             // requests per minute
  // }
}
