{
  "name": "acp-connector",
  "version": "0.5.0",
  "description": "Thin bridge connecting messaging platforms to any ACP-compatible coding agent",
  "type": "module",
  "bin": {
    "acp-connector": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "setup": "tsx src/index.ts setup",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:json": "vitest run --reporter=json --outputFile=.context/test-results.json",
    "behavior": "vitest run --reporter=json --outputFile=.context/test-results.json && node scripts/compile-behavior.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "telegram",
    "bridge",
    "ai",
    "coding-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galiprandi/acp-connector.git"
  },
  "homepage": "https://github.com/galiprandi/acp-connector#readme",
  "bugs": {
    "url": "https://github.com/galiprandi/acp-connector/issues"
  },
  "author": "Germán Aliprandi",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "README.md",
    "AGENTS.md",
    "acp-connector.example.jsonc"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.0",
    "node-cron": "^4.0.0",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@vitest/coverage-v8": "^5.0.0",
    "commitlint": "^21.2.2",
    "husky": "^9.1.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
